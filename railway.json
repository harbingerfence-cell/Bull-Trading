{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "sh -c 'python -m bull_brain.webhook --limits limits.paper.json --symbols ${WEBHOOK_SYMBOLS:-SPY,QQQ,AAPL,MSFT,NVDA}'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
